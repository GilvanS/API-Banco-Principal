{
  "info": {
    "name": "API Banco Principal - Investimentos",
    "description": "Collection completa dos endpoints de investimentos da API do Banco Principal",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{jwt_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "jwt_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "investment_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', response.token);",
                  "    console.log('Token JWT salvo:', response.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"usuario@teste.com\",\n  \"senha\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            },
            "description": "Endpoint para autenticação do usuário. O token JWT retornado será automaticamente salvo na variável jwt_token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Investimentos",
      "item": [
        {
          "name": "Resumo de Investimentos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/investments/summary",
              "host": ["{{base_url}}"],
              "path": ["investments", "summary"]
            },
            "description": "Retorna um resumo completo dos investimentos do usuário, incluindo total investido, valor atual, rentabilidade e agrupamento por tipo."
          },
          "response": [
            {
              "name": "Sucesso",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/investments/summary",
                  "host": ["{{base_url}}"],
                  "path": ["investments", "summary"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"totalInvested\": 300,\n  \"currentValue\": 300,\n  \"totalReturn\": 0,\n  \"returnPercentage\": 0,\n  \"activeInvestments\": 1,\n  \"byType\": [\n    {\n      \"tipo\": \"POUPANCA\",\n      \"quantidade\": 1,\n      \"valorInvestido\": 300,\n      \"valorAtual\": 300,\n      \"rentabilidade\": 0\n    }\n  ],\n  \"recentInvestments\": [\n    {\n      \"id\": \"267c29c5-a10c-48c4-9035-0c2fdf80dab6\",\n      \"name\": \"POUPANCA\",\n      \"type\": \"POUPANCA\",\n      \"investedAmount\": 300,\n      \"currentValue\": 300,\n      \"returnPercentage\": 0,\n      \"status\": \"ATIVO\",\n      \"createdAt\": \"2025-09-11T01:43:53.000Z\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Aplicar em Investimento",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('investment_id', response.investmentId);",
                  "    console.log('Investment ID salvo:', response.investmentId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"POUPANCA\",\n  \"valor\": 500.00,\n  \"nome\": \"Poupança Teste\",\n  \"descricao\": \"Investimento de teste via Postman\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/investments/apply",
              "host": ["{{base_url}}"],
              "path": ["investments", "apply"]
            },
            "description": "Cria uma nova aplicação de investimento. O valor é debitado automaticamente da conta corrente. O ID do investimento criado será salvo automaticamente na variável investment_id."
          },
          "response": []
        },
        {
          "name": "Listar Aplicações",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/investments/applications",
              "host": ["{{base_url}}"],
              "path": ["investments", "applications"],
              "query": [
                {
                  "key": "status",
                  "value": "ATIVO",
                  "disabled": true
                },
                {
                  "key": "tipo",
                  "value": "POUPANCA",
                  "disabled": true
                }
              ]
            },
            "description": "Retorna uma lista completa de todos os investimentos do usuário. Pode ser filtrada por status e tipo."
          },
          "response": []
        },
        {
          "name": "Consultar Rendimento",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/investments/{{investment_id}}/yield",
              "host": ["{{base_url}}"],
              "path": ["investments", "{{investment_id}}", "yield"]
            },
            "description": "Retorna informações detalhadas sobre o rendimento de um investimento específico, incluindo cálculos de rendimento absoluto, percentual e projeções."
          },
          "response": [
            {
              "name": "Sucesso",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/investments/267c29c5-a10c-48c4-9035-0c2fdf80dab6/yield",
                  "host": ["{{base_url}}"],
                  "path": ["investments", "267c29c5-a10c-48c4-9035-0c2fdf80dab6", "yield"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "body": "{\n  \"investmentId\": \"267c29c5-a10c-48c4-9035-0c2fdf80dab6\",\n  \"name\": \"POUPANCA\",\n  \"type\": \"POUPANCA\",\n  \"status\": \"ATIVO\",\n  \"investedAmount\": 300,\n  \"currentValue\": 300,\n  \"yield\": {\n    \"absolute\": 0,\n    \"percentage\": 0,\n    \"dailyAverage\": 0,\n    \"monthlyProjected\": 1.5,\n    \"annualProjected\": 18.3\n  },\n  \"period\": {\n    \"investmentDate\": \"2025-09-11T01:43:53.000Z\",\n    \"daysInvested\": 0,\n    \"maturityDate\": \"2026-09-10\"\n  },\n  \"rates\": {\n    \"returnRate\": 0.5,\n    \"currentYield\": 0\n  },\n  \"canRedeem\": true,\n  \"description\": null\n}"
            }
          ]
        },
        {
          "name": "Resgatar Investimento (Parcial)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 200.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/investments/{{investment_id}}/redeem",
              "host": ["{{base_url}}"],
              "path": ["investments", "{{investment_id}}", "redeem"]
            },
            "description": "Realiza o resgate parcial de um investimento. O valor resgatado é creditado automaticamente na conta corrente."
          },
          "response": []
        },
        {
          "name": "Resgatar Investimento (Total)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 300.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/investments/{{investment_id}}/redeem",
              "host": ["{{base_url}}"],
              "path": ["investments", "{{investment_id}}", "redeem"]
            },
            "description": "Realiza o resgate total de um investimento. O investimento será encerrado e o valor total creditado na conta corrente."
          },
          "response": []
        }
      ]
    },
